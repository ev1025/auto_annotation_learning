# deploy/.env.example -> deploy/.env 로 복사해서 쓴다(.env 는 git 에 올리지 않음).
# 코드·compose 는 이 값들만 참조하므로 개발(Windows)과 Thor(컨테이너)에서 파일만 바꿔 끼우면 된다.

XR_DB_NAME=xr_autolearning
XR_DB_USER=xr
XR_DB_PASSWORD=change_me            # 개발용이라도 기본값 그대로 쓰지 말 것
XR_DB_HOST=127.0.0.1           # Windows 에서 localhost 는 ::1(IPv6) 로 먼저 풀려 127.0.0.1 바인딩과 안 맞음. Thor 컨테이너 안에서는 서비스명(db)
XR_DB_PORT=5432

# 위 값들을 조립하지 않고 접속 문자열을 직접 지정하고 싶을 때(우선순위 최상위)
#XR_DB_URL=postgresql+psycopg://xr:비번@localhost:5432/xr_autolearning
# DB 없이 파일 한 개로 돌려볼 때
#XR_DB_URL=sqlite+pysqlite:///./xr.db
