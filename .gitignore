# ===== 데이터 (용량 큼, git 부적합) - 모든 데이터는 data/ 아래 =====
data/
data.generated.yaml

# ===== 학습/실험 산출물 =====
exp_autolearn/
exp_autolearn_*/
runs/
bench_results/runs/
finetune_real/
*.log
*.marker

# ===== 모델 가중치 =====
models/*.pt
models/*.onnx
*.pt
*.onnx
# 실증 결과 리포트(json)는 추적, 모델 파일만 제외
exp_results/*.pt
exp_results/*.onnx

# ===== 파이썬 =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ===== OS/에디터 =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# 참고 논문(용량·저작권, git 제외)
논문/

# 등록 테스트 산출물·영상 (data/ 밖에 생겨도 제외)
gearbox_register_*/
uploads/
*.mp4

# dashboard frontend
frontend/node_modules/
frontend/dist/

# self-training 영상 실험 산출물 (models/runs/frames 대용량)
exp_selftrain/
models/sam/

# ===== 밤샘/SAM2 실험 산출물 (로컬 전용, 대용량. report.json·evidence만 별도 보존) =====
exp_variance/
exp_variance_aug/
exp_variance_abc/
exp_overnight/
exp_sam2_test/
models/sam2/
# evidence/ 와 docs/ 는 추적 (큐레이션한 증거·문서)

# 실험 결과·프레임 캐시 (data/는 이미 무시됨). 무거운 산출물(모델·이미지·runs)은 제외,
# 실험 기록(수치 JSON·요약 MD)만 추적 = 대시보드 데이터 소스 + git 기록용
results/*
# 대시보드 실험탭 데이터(results/dashboard) = 수치 JSON·요약 MD 추적, 무거운 pt/onnx 제외
!results/dashboard/
!results/dashboard/**
results/dashboard/**/*.pt
results/dashboard/**/*.onnx

# 아카이브 프론트(전체 대시보드) 빌드산출물·의존성
exp_dashboard/dist/
exp_dashboard/node_modules/
backend/*/__pycache__/

# DB 로컬 볼륨·테스트 산출물
*.db

# 배포 비밀값(예시 파일만 커밋)
deploy/.env
